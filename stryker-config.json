{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/options.schema.json",
  "stryker-config": {
    "project": "medzo-sales-reporting-service.csproj",
    "test-projects": [
      "tests/Medzo.SalesReporting.Tests/Medzo.SalesReporting.Tests.csproj"
    ],
    "mutate": [
      "Services/BatchRemovalService.cs",
      "Services/ExpiryAlertService.cs",
      "Services/SaleItemSearchService.cs",
      "Services/SaleService.cs"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 75,
      "low": 65,
      "break": 65
    },
    "concurrency": 2,
    "configuration": "Release"
  }
}
